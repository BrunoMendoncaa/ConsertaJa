# Copie para .env.local e preencha. NUNCA versione o .env.local.

# URL do projeto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave PUBLICÁVEL (antiga "anon"). Pode ir para o navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Chave SECRETA (antiga "service_role"). SOMENTE servidor.
# Usada apenas para assinar URLs de fotos no portal do cliente.
# Nunca use prefixo NEXT_PUBLIC_ nesta variável.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Endereço público do sistema (links de convite, QR code, WhatsApp)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mercado Pago — assinatura do TecnoFix. SOMENTE servidor (nunca use NEXT_PUBLIC_).
# Suas integrações > sua aplicação > Credenciais. Para testar, use as credenciais do
# VENDEDOR DE TESTE e pague com o COMPRADOR DE TESTE (nada é cobrado de verdade).
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
# Reservada para pagamento dentro da página (o fluxo atual leva ao site do Mercado Pago).
MP_PUBLIC_KEY=APP_USR-xxxxxxxxxxxxxxxx
# Webhooks > Configurar notificações > assinatura secreta (valida os avisos de pagamento).
MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Conferência diária das assinaturas (Vercel Cron, ver vercel.json). Texto aleatório longo,
# só na Vercel/servidor. A Vercel envia esse valor sozinha ao chamar /api/cron/assinaturas.
CRON_SECRET=troque-por-um-texto-aleatorio-longo
